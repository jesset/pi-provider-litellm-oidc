{
  "name": "pi-provider-litellm-oidc",
  "version": "0.13.1",
  "description": "Keyless OIDC (Keycloak device flow) provider for LiteLLM gateways — pi coding agent extension",
  "type": "module",
  "license": "MIT",
  "author": "jesse <i@zeroeffort.cc>",
  "homepage": "https://github.com/jesset/pi-provider-litellm-oidc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesset/pi-provider-litellm-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/jesset/pi-provider-litellm-oidc/issues"
  },
  "keywords": [
    "pi-package",
    "pi-mono",
    "litellm",
    "oidc",
    "keycloak",
    "keyless"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "bun test",
    "supply-chain:guard": "node scripts/supply-chain-guard.mjs",
    "prepare": "test -d node_modules/esbuild || npm install --no-save --no-audit --no-fund --include=dev esbuild@0.25.12; node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:check": "node scripts/check-docs-links.mjs"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-cn.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^26.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
